#!/bin/bash
#==============================================================================
# PBS Job Script: Bayesian Transit Fit
#==============================================================================

#PBS -N run_multi_APC
#PBS -l select=1:ncpus=16
#PBS -l walltime=48:00:00

#------------------------------------------------------------------------------
# Timestamped output/error files
#------------------------------------------------------------------------------
TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
LOGDIR="/mnt/home/project/cnitesh/nitesh/tess_exoplanet_pipeline/pbs_query"

exec > "${LOGDIR}/run_multi_APC_${TIMESTAMP}.out" \
     2> "${LOGDIR}/run_multi_APC_${TIMESTAMP}.err"


#------------------------------------------------------------------------------
# Go to submission directory
#------------------------------------------------------------------------------
cd "$PBS_O_WORKDIR"

#------------------------------------------------------------------------------
# Load software
#------------------------------------------------------------------------------

module load gcc/11.2.0 cuda9.2 anaconda3

# Initialize conda for the bash shell script
eval "$(conda shell.bash hook)"

# Now activate the environment
conda activate exo_model

# check if the environment is activated
echo $CONDA_DEFAULT_ENV

# Prevent CPU oversubscription when running multi-chain inference.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export BLIS_NUM_THREADS=1

#------------------------------------------------------------------------------
# Job information
#------------------------------------------------------------------------------
echo "============================================================"
echo "                PBS JOB INFORMATION"
echo "============================================================"
echo "Job ID          : ${PBS_JOBID}"
echo "Job Name        : ${PBS_JOBNAME}"
echo "Queue           : ${PBS_QUEUE}"
echo "Host            : $(hostname)"
echo "Working Dir     : ${PBS_O_WORKDIR}"
echo "Start Time      : $(date)"
echo "Allocated CPUs  : ${PBS_NP:-Unknown}"
echo "OMP_NUM_THREADS : ${OMP_NUM_THREADS}"
echo "OPENBLAS_THREADS: ${OPENBLAS_NUM_THREADS}"
echo "MKL_NUM_THREADS : ${MKL_NUM_THREADS}"
echo "NUMEXPR_THREADS : ${NUMEXPR_NUM_THREADS}"
echo "BLIS_NUM_THREADS: ${BLIS_NUM_THREADS}"
echo "============================================================"

echo
echo "Python executable:"
which python

echo
python --version

echo
echo "Package versions:"

echo
echo "============================================================"
echo "Starting Bayesian analysis..."
echo "============================================================"

SECONDS=0

/usr/bin/time -v python -u \
/mnt/home/project/cnitesh/nitesh/tess_exoplanet_pipeline/run_multi.py

status=$?

echo
echo "============================================================"
echo "Finished at : $(date)"
echo "Elapsed     : $(($SECONDS/3600))h $((($SECONDS%3600)/60))m $(($SECONDS%60))s"
echo "Exit Status : ${status}"
echo "============================================================"

exit ${status}
